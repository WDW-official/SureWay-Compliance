# Run on Node.js 20.9+ with a reachable MongoDB server.
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DB=sureway

# Keep false until SureWay approves the fees in lib/catalog.ts.
PRICING_CONFIRMED=false

# Use a Paystack test key until end-to-end payment verification is complete.
PAYSTACK_SECRET_KEY=

# Authenticated Cloudinary storage; never use public unsigned upload presets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin password: at least 16 characters; session secret: at least 32 random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email delivery with a verified Resend sending domain.
RESEND_API_KEY=
EMAIL_FROM=SureWay Compliance <documents@your-domain.example>
TEAM_EMAIL=

# Meta WhatsApp Cloud API. Approved utility template with TWO body text parameters:
# 1: notification subject, 2: notification text and document links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# A separate random bearer secret for the notification retry job.
CRON_SECRET=
